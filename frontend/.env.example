# Copy to .env.local (gitignored) and adjust for your deployment.
#
# Where the built frontend is mounted (index.html + /assets).
# The build output lands in dist/<prefix>/ (here: dist/ops-wxgzt/).
# Leave unset for the root path "/" and a flat dist/.
VITE_BASE_PATH=/ops-wxgzt/

# Full API base as seen by the BROWSER. Must map to backend /api/v1 through
# your reverse proxy, and is used by REST calls, download links and WebSocket.
# Leave unset to default to "<VITE_BASE_PATH>api/v1".
VITE_API_BASE=/ops-server/api/v1
