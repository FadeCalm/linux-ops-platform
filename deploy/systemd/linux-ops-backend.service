[Unit]
Description=Linux Ops Platform — Management Backend
Documentation=file:///opt/linux-ops-platform/docs/architecture.md
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=linuxops
Group=linuxops
WorkingDirectory=/opt/linux-ops-platform
# DB_PASSWORD / LISTEN_ADDR / FRONTEND_DIR live here (chmod 600, root:root)
EnvironmentFile=/etc/linux-ops/backend.env
ExecStart=/opt/linux-ops-platform/bin/backend -config /etc/linux-ops/backend.yaml
Restart=on-failure
RestartSec=3
LimitNOFILE=65536
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
