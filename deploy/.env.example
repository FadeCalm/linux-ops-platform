# Copy to deploy/.env and set strong values. Never commit deploy/.env.

MYSQL_ROOT_PASSWORD=replace-with-strong-root-password
DB_NAME=linux_ops
DB_USER=ops
DB_PASSWORD=replace-with-strong-ops-password

MINIO_ROOT_USER=opsminio
MINIO_ROOT_PASSWORD=replace-with-strong-minio-password

# Password for the web UI / API (written to /etc/linux-ops/backend.env as
# ACCESS_PASSWORD by scripts/install.sh). Leave empty to have the installer
# generate one and print it. This is a single shared gate, not user accounts.
ACCESS_PASSWORD=replace-with-a-strong-access-password
